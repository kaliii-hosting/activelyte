# ============================================================================
# Activelyte — environment variables (TEMPLATE — names only, no secrets)
# Copy to `.env.local` and fill in real values from the Firebase console.
# `.env.local` is gitignored; never commit real secrets.
# ============================================================================

# --- Client Firebase config (safe to expose; identifies the project) --------
# Firebase console → Project settings → General → "Your apps" → Web app → SDK
# setup and configuration → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database (used only for presence + typing indicators).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Cloud Messaging web push (console → Project settings → Cloud Messaging →
# Web configuration → Web Push certificates → key pair).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# App Check reCAPTCHA v3 site key (console → App Check → Apps → register).
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Set to "true" to point the client SDK at the local Firebase Emulator Suite
# instead of the live project (local development only).
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# --- Server / admin (SECRET — never exposed to the browser) -----------------
# Firebase console → Project settings → Service accounts → Generate new private
# key. Paste the three matching values from the downloaded JSON below.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes; the literal \n escapes are un-escaped in code.
FIREBASE_PRIVATE_KEY=""

# --- App bootstrap ----------------------------------------------------------
# The seed founder account (top authority; cannot be self-registered).
FOUNDER_EMAIL=kushieweb@gmail.com

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template (names only, no secrets) IS committed
!.env.example

# service-account keys / any Firebase Admin credential JSON
*-service-account*.json
firebase-adminsdk*.json
serviceAccountKey*.json

# firebase CLI artifacts
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# cloud functions build output + deps
functions/lib/
functions/node_modules/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

rules_version = '2';

// Activelyte Firestore Security Rules.
//
// Model: privileged writes (users, orgs, shops, audit logs) happen ONLY through
// the Admin SDK server-side, which bypasses rules — so those are read-gated here
// and client-writes are denied. Messaging is the exception: clients read/write
// conversations + messages directly (real-time chat), strictly gated to members.
//
// Deployed incrementally as features land; extended in later phases (loyalty,
// products, notifications, App Check). Default is deny.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myOrg()  { return request.auth.token.organizationId; }
    function myRole() { return request.auth.token.role; }
    function isAdminTier() { return myRole() in ['founder', 'super_admin', 'admin']; }
    function sameOrg(org) { return isSignedIn() && org == myOrg(); }

    // ---- Organizations: read your own org; writes are Admin-only ----------
    match /organizations/{orgId} {
      allow read: if isSignedIn() && orgId == myOrg();
      allow write: if false;
    }

    // ---- Users: read profiles in your org; writes are Admin-only ----------
    // (role/status/org are set via custom claims + Admin SDK, never the client.)
    match /users/{uid} {
      allow read: if isSignedIn() &&
        (uid == request.auth.uid || sameOrg(resource.data.organizationId));
      // Users may edit ONLY their own display name, photo, and preferences —
      // never role/status/organization/email (those are Admin-SDK-only).
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL', 'preferences', 'updatedAt']);
      allow create, delete: if false;

      match /devices/{deviceId} {
        // A user manages only their own FCM device registrations.
        allow read, write: if request.auth.uid == uid;
      }
    }

    // ---- Shops + membership: read within your org; writes Admin-only ------
    match /shops/{shopId} {
      allow read: if isSignedIn() && sameOrg(resource.data.organizationId);
      allow write: if false;
      match /members/{memberUid} {
        allow read: if isSignedIn() && sameOrg(resource.data.organizationId);
        allow write: if false;
      }
    }

    // ---- Audit logs: admin-tier read only; append-only via Admin SDK ------
    match /auditLogs/{logId} {
      allow read: if isAdminTier() && sameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // ---- Broadcasts: admin record of a sent private broadcast --------------
    // Created only by the sendPrivateBroadcast Cloud Function (Admin SDK).
    match /broadcasts/{broadcastId} {
      allow read: if isAdminTier() && sameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // ---- Products: read within org; writes Admin-only ----------------------
    match /products/{productId} {
      allow read: if isSignedIn() && sameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // ---- Product codes: NEVER client-readable (raw reward codes) -----------
    // Validated + redeemed only via the validateAndRedeemCode function.
    match /productCodes/{codeId} {
      allow read, write: if false;
    }

    // ---- Scan events: your own history, or admins; writes server-only ------
    match /scanEvents/{scanId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         (isAdminTier() && sameOrg(resource.data.organizationId)));
      allow write: if false;
    }

    // ---- Loyalty account + ledger: read own or admin; writes function-only -
    match /loyaltyAccounts/{accountId} {
      allow read: if isSignedIn() &&
        (accountId == request.auth.uid ||
         (isAdminTier() && sameOrg(resource.data.organizationId)));
      allow write: if false;
    }
    match /loyaltyTransactions/{txnId} {
      allow read: if isSignedIn() &&
        (resource.data.accountId == request.auth.uid ||
         (isAdminTier() && sameOrg(resource.data.organizationId)));
      allow write: if false;
    }

    // ---- Rewards catalog: read within org; writes Admin-only ---------------
    match /rewards/{rewardId} {
      allow read: if isSignedIn() && sameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // ---- Redemptions: your own or admin; writes function-only --------------
    match /redemptions/{redemptionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         (isAdminTier() && sameOrg(resource.data.organizationId)));
      allow write: if false;
    }

    // ---- App settings: admin-tier read within org; writes Admin-only -------
    match /appSettings/{settingsId} {
      allow read: if isAdminTier() && sameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // ---- Notifications: your own; created by functions; you may mark read ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Only allowed client change is flipping `read`; identity fields are fixed.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.type == resource.data.type;
      allow create, delete: if false;
    }

    // ---- Conversations + messages: client real-time, members only --------
    function convMembers(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data.memberIds;
    }

    match /conversations/{cid} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // Direct + group creation from the client. Broadcasts are created only
      // server-side (Cloud Function) so this rejects type == 'broadcast'.
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.organizationId == myOrg()
        && request.resource.data.type in ['direct', 'group']
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50;

      // Members may update conversation metadata (e.g. lastMessage) but never
      // the membership set, type, org, or creator from the client.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.type == resource.data.type
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      // Per-member state (lastReadAt, muted). A user writes only their OWN doc,
      // and only for a conversation they belong to.
      match /members/{memberUid} {
        allow read: if isSignedIn() && request.auth.uid in convMembers(cid);
        allow create, update: if request.auth.uid == memberUid
          && request.auth.uid in convMembers(cid)
          && request.resource.data.uid == memberUid;
        allow delete: if false;
      }

      match /messages/{messageId} {
        function validText() {
          return request.resource.data.type == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000;
        }
        function validAttachment() {
          return request.resource.data.type in ['image', 'file', 'voice']
            && request.resource.data.attachment is map
            && request.resource.data.attachment.url is string
            && request.resource.data.attachment.path is string
            && request.resource.data.attachment.size is number
            && request.resource.data.attachment.size <= 10737418240 // 10 GB
            && (!('text' in request.resource.data)
                || (request.resource.data.text is string
                    && request.resource.data.text.size() <= 4000));
        }
        allow read: if isSignedIn() && request.auth.uid in convMembers(cid);
        allow create: if isSignedIn()
          && request.auth.uid in convMembers(cid)
          && request.resource.data.senderId == request.auth.uid
          && (validText() || validAttachment());
        // Sender may edit their own message (edit/soft-delete); never reassign.
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId;
        allow delete: if false;
      }
    }
  }
}
